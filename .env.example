# Language Lab environment template.
# Copy to .env for local development only. Never commit real keys.
# Runtime builds read provider keys from the OS keyring via the Rust core,
# NOT from this file.

# Default LLM provider (e.g. openai, anthropic, ...)
LLM_PROVIDER=openai

# Optional: dev-server only overrides. Ignored in packaged builds.
# LLM_API_KEY=
# ASR_PROVIDER=
# ASR_API_KEY=
# TTS_PROVIDER=
# TTS_API_KEY=
