{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
    },
    "objectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetVocabulary": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "courseTemplate": {
      "type": "object",
      "properties": {
        "targetLanguage": {
          "type": "string",
          "minLength": 1
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "setting": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "object",
          "properties": {
            "learner": {
              "type": "string",
              "minLength": 1
            },
            "partner": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["learner", "partner"],
          "additionalProperties": false
        },
        "openingLine": {
          "type": "string",
          "minLength": 1
        },
        "targetPatterns": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "example": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["pattern", "example"],
            "additionalProperties": false
          }
        },
        "stages": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              },
              "objectiveIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^obj-[1-9]\\d*$"
                }
              },
              "successCriteria": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "hints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["id", "title", "instruction", "objectiveIds", "successCriteria", "hints"],
            "additionalProperties": false
          }
        },
        "teachingPolicy": {
          "type": "object",
          "properties": {
            "correctionMode": {
              "type": "string",
              "enum": ["gentle", "off"]
            },
            "maxCorrections": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "maxHints": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          },
          "required": ["correctionMode", "maxCorrections", "maxHints"],
          "additionalProperties": false
        },
        "learningPack": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "overview": {
              "type": "string",
              "minLength": 1
            },
            "prerequisites": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scenarioFacts": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["label", "value"],
                "additionalProperties": false
              }
            },
            "vocabulary": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "term": {
                    "type": "string",
                    "minLength": 1
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1
                  },
                  "translation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "example": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["term", "meaning", "example"],
                "additionalProperties": false
              }
            },
            "warmup": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "suggestedAnswer": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["id", "prompt", "suggestedAnswer"],
                "additionalProperties": false
              }
            },
            "modelDialogue": {
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stageId": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["learner", "partner"]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["stageId", "role", "text"],
                "additionalProperties": false
              }
            },
            "guidedPractice": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stageId": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "suggestedReply": {
                    "type": "string",
                    "minLength": 1
                  },
                  "partnerPrompt": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["stageId", "suggestedReply", "partnerPrompt"],
                "additionalProperties": false
              }
            },
            "reviewPractice": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "suggestedAnswer": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["id", "prompt", "suggestedAnswer"],
                "additionalProperties": false
              }
            },
            "variations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "briefing": {
                    "type": "string",
                    "minLength": 1
                  },
                  "settingAddition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "openingLine": {
                    "type": "string",
                    "minLength": 1
                  },
                  "factOverrides": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["label", "value"],
                      "additionalProperties": false
                    }
                  },
                  "stageOverrides": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "stageId": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[a-z0-9-]+$"
                        },
                        "instruction": {
                          "type": "string",
                          "minLength": 1
                        },
                        "successCriteria": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "hints": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "suggestedReply": {
                          "type": "string",
                          "minLength": 1
                        },
                        "partnerPrompt": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "stageId",
                        "instruction",
                        "successCriteria",
                        "hints",
                        "suggestedReply",
                        "partnerPrompt"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "title",
                  "briefing",
                  "settingAddition",
                  "factOverrides",
                  "stageOverrides"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schemaVersion",
            "overview",
            "prerequisites",
            "scenarioFacts",
            "vocabulary",
            "warmup",
            "modelDialogue",
            "guidedPractice",
            "reviewPractice",
            "variations"
          ],
          "additionalProperties": false
        },
        "selectedVariationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "targetLanguage",
        "estimatedMinutes",
        "setting",
        "roles",
        "openingLine",
        "targetPatterns",
        "stages",
        "teachingPolicy"
      ],
      "additionalProperties": false
    }
  },
  "required": ["id", "slug", "title", "category", "difficulty", "objectives", "targetVocabulary"],
  "additionalProperties": false
}
