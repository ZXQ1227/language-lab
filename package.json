{
  "name": "language-lab",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "description": "Local-first AI language learning desktop app built with Tauri 2, React and TypeScript.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @language-lab/desktop dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:travel": "vitest run tests/evals/travel.test.ts",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@language-lab/agent-runtime": "workspace:*",
    "@language-lab/core": "workspace:*",
    "@language-lab/database": "workspace:*",
    "@language-lab/memory": "workspace:*",
    "@language-lab/model-gateway": "workspace:*",
    "@language-lab/shared": "workspace:*",
    "@language-lab/skills": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  }
}
