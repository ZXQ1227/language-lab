{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sayden",
  "version": "0.0.1",
  "identifier": "com.languagelab.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sayden",
        "width": 1120,
        "height": 760,
        "minWidth": 600,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "windows": {
      "wix": {
        "upgradeCode": "fb70951d-e596-566b-b1e9-1f718ccc13dc"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
